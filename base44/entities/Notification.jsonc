{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_id": {
      "type": "string",
      "description": "User id of the recipient"
    },
    "message": {
      "type": "string",
      "description": "Notification text"
    },
    "type": {
      "type": "string",
      "enum": [
        "moderation",
        "system"
      ],
      "default": "system",
      "description": "Notification category"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Read status"
    },
    "video_slug": {
      "type": "string",
      "description": "Related video slug, when relevant"
    }
  },
  "required": [
    "recipient_id",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}