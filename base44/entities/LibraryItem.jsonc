{
  "name": "LibraryItem",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string",
      "description": "Saved video reference (VYBEX record id, or provider:id for external videos)"
    },
    "video_slug": {
      "type": "string",
      "description": "Saved video slug (denormalized)"
    },
    "video_title": {
      "type": "string",
      "description": "Saved video title (denormalized)"
    },
    "video_thumbnail": {
      "type": "string",
      "description": "Saved video artwork (denormalized)"
    },
    "video_category": {
      "type": "string",
      "description": "Saved video category (denormalized)"
    },
    "video_duration_seconds": {
      "type": "number",
      "description": "Saved video duration (denormalized)"
    },
    "provider": {
      "type": "string",
      "enum": [
        "vybex",
        "youtube"
      ],
      "default": "vybex",
      "description": "Where the saved video comes from"
    },
    "provider_video_id": {
      "type": "string",
      "description": "The provider's own video identifier, when saved from YouTube"
    },
    "creator_name": {
      "type": "string",
      "description": "Channel or creator name (denormalized)"
    },
    "source_url": {
      "type": "string",
      "description": "Original provider URL (YouTube watch page)"
    },
    "collection": {
      "type": "string",
      "description": "Optional collection name"
    }
  },
  "required": [
    "video_id",
    "video_slug",
    "video_title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}